# Copy to .env.local and fill in.
# Everything here is optional for local development — with no values set the
# studio runs in "dev" auth mode and behaves exactly as it did before auth
# existed.

# ── Privy (https://dashboard.privy.io) ──
# Both are required to run in "privy" auth mode.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Auth mode ──
# privy — verify real Privy access tokens.
# dev   — everyone is AWE_DEV_USER_ID. The default when PRIVY_APP_SECRET is unset.
# off   — no notion of users; used by headless tooling and tests.
# Production refuses to start unless this is "privy".
AWE_AUTH_MODE=dev
AWE_DEV_USER_ID=dev-owner

# ── Game server (Colyseus) ──
# Port the game server listens on. Defaults to 2567.
# GAME_SERVER_PORT=2567
# Where browsers connect. Defaults to port 2567 on the host serving the page
# (ws:// on http, wss:// on https). Behind a TLS proxy, e.g.:
# NEXT_PUBLIC_GAME_SERVER_URL=wss://game.example.com

# ── Data directory ──
# Where world data (scene, chunks) is read from and written to.
# Defaults to ./.data if it exists, else ./public/data.
AWE_DATA_DIR=

# ── Sign in with Keplr (Cosmos Hub) ──
# Keplr sign-ins are handed to Privy as custom JWTs. Also enable "Custom auth"
# in the Privy dashboard and point JWT-based auth at:
#   JWKS URL: https://<your-host>/api/auth/keplr/jwks   user id claim: sub
# KEPLR_AUTH_SECRET: any long random string (signs sign-in nonces).
# KEPLR_JWT_PRIVATE_KEY: PKCS8 PEM, newlines as \n. RSA (RS256) or P-256 (ES256).
#   Use RSA if you paste a certificate into Privy instead of the JWKS URL
#   (Privy only accepts RSA certificates):
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out key.pem
#     openssl req -new -x509 -key key.pem -subj "/CN=awe-keplr" -days 3650 -out cert.pem
#   Privy settings: user id claim `sub`, client side, aud `awe-keplr`.
KEPLR_AUTH_SECRET=
KEPLR_JWT_PRIVATE_KEY=
NEXT_PUBLIC_COSMOS_CHAIN_ID=cosmoshub-4
NEXT_PUBLIC_COSMOS_RPC=https://cosmos-rpc.publicnode.com:443
COSMOS_LCD=https://cosmos-rest.publicnode.com

# ── Token gates (CFT-20 / inscriptions) ──
# Holdings come from an Asteroid Protocol indexer when this is set. The public
# api.asteroidprotocol.io no longer resolves; point it at a self-hosted indexer
# or any endpoint exposing the same Hasura schema.
ASTEROID_GRAPHQL_URL=
# Without an indexer, holdings are read from this JSON file (kept out of public/):
#   { "cosmos1…": { "cft20": { "ROIDS": "1000" }, "inscriptions": ["collection"] } }
AWE_HOLDINGS_FILE=.data/holdings.json
# In dev auth mode (no Privy) the shared dev user checks gates as this address.
AWE_DEV_COSMOS_ADDRESS=
# ...and EVM gates (ETH, Base, Polygon, …) as this 0x wallet.
AWE_DEV_EVM_ADDRESS=

# ── Token gates (EVM chains) ──
# ERC-20 / NFT gates read balances straight from each chain over public RPCs
# (publicnode.com). Override one with EVM_RPC_<CHAIN>, e.g. an Alchemy URL:
# EVM_RPC_ETHEREUM=
# EVM_RPC_BASE=
# EVM_RPC_POLYGON=
# EVM_RPC_ARBITRUM=
# EVM_RPC_OPTIMISM=
# EVM_RPC_BSC=
# EVM_RPC_AVALANCHE=

# ── Owner, roles & members ──
# The one world owner, set at world setup: a Privy user id (did:privy:…) or a
# cosmos1… address. The owner has every permission and can't be demoted or
# banned. Unset in dev auth mode, the dev user is the owner (which also means
# it bypasses token gates; set this to someone else to test gates locally).
AWE_OWNER_ID=
# Roles, members and bans. Kept out of public/: it lists user ids and wallets.
# The first run seeds default roles (or imports an old public/data/roles.json).
AWE_ACCESS_FILE=.data/access.json

# ── Voice chat (peer-to-peer WebRTC) ─────────────────────────────────────────
# STUN servers help players connect directly. Defaults to Google's public ones.
# AWE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN relays audio for players whose network blocks direct connections
# (~10-20%: some mobile and office networks). Without it they can't hear or be heard.
# AWE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# Preferred: coturn's static-auth-secret. Players get credentials that expire after a day.
# AWE_TURN_SECRET=
# Or fixed credentials (visible to every player):
# AWE_TURN_USERNAME=
# AWE_TURN_CREDENTIAL=

# Player profiles (username, picture, primary address). Outside public/: the
# file maps account ids to profiles. Uploaded pictures go in AWE_AVATAR_DIR.
AWE_PROFILES_FILE=.data/profiles.json
AWE_AVATAR_DIR=.data/avatars
